#!/usr/bin/env python3
"""Skate 3 Level Loader - pick a map, it boots straight into it.

    ./skate3loader                     open the library
    ./skate3loader import <path.big>   import a map pack from the terminal
    ./skate3loader list                list imported packs and their maps
    ./skate3loader play <world-id>     boot straight into one map, no GUI
    ./skate3loader run [world-id]      play; starts at the in-game map picker
    ./skate3loader manual <pack-id>    stage a pack, no automation - you navigate
    ./skate3loader scan [dir]          import every usable pack in a folder
    ./skate3loader doctor              check the environment
"""

import sys
from pathlib import Path

import os

# Must run before ANY gi import: importing gi.repository.Gdk opens the
# default display, and the backend chosen there cannot be changed later.
# Wayland gives no way for a client to raise itself above the game.
os.environ.setdefault("GDK_BACKEND", "x11")

sys.path.insert(0, str(Path(__file__).resolve().parent))


def cmd_import(args) -> int:
    from loader import catalog, config

    if not args:
        print("usage: skate3loader import <path to .big>", file=sys.stderr)
        return 2
    try:
        pack = catalog.import_pack(Path(args[0]), config.CATALOG_DIR)
    except catalog.ImportError_ as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"imported {pack.name} ({pack.package}) - {len(pack.maps)} maps")
    for entry in pack.maps:
        print(f"  {entry.sub_index:2d}  {entry.name:<20} {entry.world_id}")
    return 0


def cmd_list(_args) -> int:
    from loader import catalog, config

    packs = catalog.load_all(config.CATALOG_DIR)
    if not packs:
        print("no packs imported yet")
        return 0
    for pack in packs:
        print(f"{pack.name}  [{pack.package}]  {len(pack.maps)} maps")
        for entry in pack.maps:
            mark = "verified" if entry.verified else ""
            print(f"  {entry.sub_index:2d}  {entry.name:<20} {entry.world_id:<20} {mark}")
    return 0


def cmd_scan(args) -> int:
    from loader import config, discover

    directory = Path(args[0]).expanduser() if args else Path.home() / "Downloads"
    print(f"scanning {directory}\n")
    results = discover.import_directory(
        directory, on_progress=lambda p: print(f"  ... {p.name}", flush=True)
    )
    print()
    imported = [r for r in results if r.kind == "imported"]
    for r in imported:
        print(f"[ok]      {r.path.name}\n            {r.detail}")
    for r in results:
        if r.kind != "imported":
            print(f"[skipped] {r.path.name}\n            {r.detail}")
    print(f"\n{len(imported)} of {len(results)} candidates imported")
    return 0


def cmd_run(args) -> int:
    """Play, and keep the launcher alive so the in-game picker can switch packs."""
    from loader import catalog, config, supervisor

    packs = catalog.load_all(config.CATALOG_DIR)
    if not packs:
        print("no packs imported; run: ./skate3loader scan ~/Downloads", file=sys.stderr)
        return 1

    world = args[0] if args and not args[0].startswith("-") else None
    windowed = "--windowed" in args
    # With no map named, start at the in-game picker instead of a specific map.
    open_picker = world is None

    # Stage the biggest pack: its maps switch in place, others restart.
    entry, pack = None, max(packs, key=lambda p: len(p.maps))
    if world:
        for candidate in packs:
            found = candidate.map_by_world(world)
            if found:
                entry, pack = found, candidate
                break
        if entry is None:
            print(f"no map {world!r}; try ./skate3loader list", file=sys.stderr)
            return 1

    total = sum(len(p.maps) for p in packs)
    print(f":: {total} maps across {len(packs)} pack(s)")
    print(":: Esc in game opens the map list; picking another pack restarts here")
    sup = supervisor.Supervisor(on_event=lambda m: print(f"   {m}", flush=True))
    return sup.run(pack, entry, open_picker=open_picker, windowed=windowed)


def cmd_manual(args) -> int:
    """Stage a pack and hand the game over, with no automation at all.

    The diagnostic for maps that never load. Everything the loader normally does
    to steer you into a map is off - no macro, no warp substitution, no loading
    cover - so what you get is the game booted with that DLC installed and its
    own menus in front of you.

    That distinction has never been tested. Every hypothesis ruled out so far
    about the 14 broken maps was measured with this automation still running, so
    "the loader breaks them" and "they are broken" were never separated. If you
    can reach the world by hand, the fault is ours.
    """
    from loader import catalog, config, launch

    packs = catalog.load_all(config.CATALOG_DIR)
    target = args[0] if args and not args[0].startswith("-") else None
    if not target:
        print("usage: ./skate3loader manual <world-id|pack-id> [--windowed]",
              file=sys.stderr)
        print("\npacks:", file=sys.stderr)
        for pack in packs:
            broken = sum(1 for m in pack.maps if m.status == "stalls")
            mark = f"  ({broken} of {len(pack.maps)} never load)" if broken else ""
            print(f"  {pack.id}{mark}", file=sys.stderr)
        return 2

    entry, pack = None, None
    for candidate in packs:
        if candidate.id == target:
            pack, entry = candidate, sorted(candidate.maps,
                                            key=lambda m: m.sub_index)[0]
            break
        found = candidate.map_by_world(target)
        if found:
            pack, entry = candidate, found
            break
    if pack is None:
        print(f"no pack or map {target!r}; try ./skate3loader list", file=sys.stderr)
        return 1

    import time

    windowed = "--windowed" in args
    launch.clear_request()
    while True:
        print(f":: staging {pack.name} - {len(pack.maps)} map(s)")
        print(":: NO automation: no macro, no warp, no loading cover")
        print(":: navigate the game's own menus. Backtick opens the loader picker.")
        print(f":: log: {config.FREESKATE_DIR / 'runtime' / 'logs' / 'freeskate.log'}")
        session = launch.launch(pack, entry, macro="", manual=True,
                                all_packs=packs, windowed=windowed)

        # SERVICE THE PICKER. It is on in this mode (and lists the broken maps
        # deliberately), but nothing here used to read its request file - so a
        # pick wrote a request, no one answered, and the game just sat there
        # looking like the picker was broken. Reported from a real session.
        try:
            request = None
            while session.process.poll() is None:
                request = launch.read_request()
                if request is not None:
                    launch.clear_request()
                    break
                time.sleep(0.25)
        except KeyboardInterrupt:
            session.stop()
            return 130

        if request is None:
            return session.process.poll() or 0

        pack_id, sub_index = request
        nxt = next((p for p in packs if p.id == pack_id), None)
        entry = next((m for m in (nxt.maps if nxt else [])
                      if m.sub_index == sub_index), None)
        if nxt is None or entry is None:
            print(f":: unknown pick {pack_id}.{sub_index}", file=sys.stderr)
            session.stop()
            return 1
        print(f"\n:: picked {nxt.name} / {entry.name} - relaunching manually")
        pack = nxt
        session.stop()
        launch.kill_running_game()


def cmd_doctor(_args) -> int:
    from loader import doctor

    ok, lines = doctor.run()
    for line in lines:
        print(line)
    print()
    print("ready" if ok else "not ready - fix the FAIL lines above")
    return 0 if ok else 1


def cmd_play(args) -> int:
    from scripts import smoke_launch  # noqa: F401

    sys.argv = ["smoke_launch"] + list(args)
    return smoke_launch.main()


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in {"-h", "--help", "help"}:
        print(__doc__)
        return 0
    if args:
        commands = {
            "import": cmd_import,
            "list": cmd_list,
            "play": cmd_play,
            "doctor": cmd_doctor,
            "run": cmd_run,
            "manual": cmd_manual,
            "scan": cmd_scan,
        }
        handler = commands.get(args[0])
        if handler:
            return handler(args[1:])
        print(f"unknown command {args[0]!r}; try --help", file=sys.stderr)
        return 2

    from loader import app

    return app.main([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
